{
  "cli": {
    "version": ">= 7.1.2"
  },
  "build": {
    "dev": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "main",
      "env": {
        "STAGE": "dev"
      }
    },
    "dev-simulator": {
      "extends": "dev",
      "ios": {
        "simulator": true
      }
    },
    "staging": {
      "env": {
        "STAGE": "staging"
      },
      "channel": "staging"
    },
    "production": {
      "env": {
        "STAGE": "production"
      },
      "channel": "production"
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "ascAppId": "<TODO>",
        "appleTeamId": "<TODO>"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "applicationId": "<TODO>"
      }
    },
    "production": {
      "ios": {
        "appleTeamId": "<TODO>",
        "ascAppId": "<TODO>",
        "language": "fr-FR",
        "appName": "<TODO: Name visible on the app store>"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed",
        "applicationId": "<TODO>"
      }
    }
  }
}
