{
  "cli": {
    "version": ">= 7.1.2"
  },
  "build": {
    "dev": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "main",
      "env": {
        "STAGE": "dev"
      }
    },
    "dev-simulator": {
      "extends": "dev",
      "ios": {
        "simulator": true
      }
    },
    "staging": {
      "env": {
        "STAGE": "staging"
      },
      "channel": "staging"
    },
    "production": {
      "env": {
        "STAGE": "production"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "82RFCZNAL6",
        "ascAppId": "6756441621",
        "language": "en-US",
        "appName": "Ride Today Companion"
      },
      "android": {
        "track": "beta",
        "releaseStatus": "completed"
      }
    }
  }
}
