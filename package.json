{
  "name": "ride-today",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:staging": "STAGE=staging expo start",
    "start:production": "STAGE=production expo start",
    "prebuild": "STAGE=dev expo prebuild",
    "prebuild:staging": "STAGE=staging expo prebuild",
    "prebuild:production": "STAGE=production expo prebuild",
    "build:production:android": "STAGE=production expo prebuild && git add . && git commit -m 'chore: bump runtime ver' && eas build --platform android --profile production",
    "build:production:ios": "STAGE=production expo prebuild && git add . && git commit -m 'chore: bump runtime ver' && eas build --platform ios --profile production",
    "build:web": "expo export -p web",
    "android": "expo run:android",
    "ios": "expo run:ios --device",
    "web": "expo start --web",
    "test:unit": "./scripts/checkTranslation.sh && jest",
    "test:lint": "./scripts/checkTranslation.sh && eslint .",
    "test:types": "./scripts/checkTranslation.sh && tsc --noEmit",
    "test": "./scripts/checkTranslation.sh && yarn test:unit && yarn test:lint && yarn test:types",
    "translations:extract": "lingui extract --clean",
    "translations:compile": "lingui compile",
    "translations:update": "lingui extract && lingui compile",
    "postinstall": "yarn translations:update",
    "create:module": "scripts/createModule.sh"
  },
  "dependencies": {
    "@emotion/native": "^11.11.0",
    "@emotion/react": "^11.14.0",
    "@expo-google-fonts/montserrat": "^0.2.3",
    "@expo/vector-icons": "^14.0.2",
    "@gorhom/bottom-sheet": "^5.1.2",
    "@lingui/react": "^5.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@tanstack/react-query": "^5.66.8",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "expo": "~52.0.46",
    "expo-application": "~6.0.2",
    "expo-blur": "~14.0.3",
    "expo-constants": "~17.0.7",
    "expo-dev-client": "~5.0.20",
    "expo-font": "~13.0.3",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.7",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-localization": "~16.0.1",
    "expo-location": "~18.0.10",
    "expo-router": "~4.0.21",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "expo-symbols": "~0.2.2",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "~14.0.2",
    "lucide-react-native": "^0.475.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "^5.0.0",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-gifted-charts": "^1.4.58",
    "react-native-mmkv": "^3.2.0",
    "react-native-pager-view": "6.5.1",
    "react-native-react-query-devtools": "^1.3.10",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5",
    "use-debounce": "^10.0.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@bam.tech/eslint-plugin": "^6.0.0",
    "@lingui/cli": "^5.2.0",
    "@lingui/macro": "^5.2.0",
    "@sucrase/jest-plugin": "^3.0.0",
    "@testing-library/react-native": "^13.0.1",
    "@types/babel-plugin-macros": "^3",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-plugin-macros": "^3.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-define-config": "^2.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^27.2.2",
    "eslint-plugin-jest-formatting": "^3.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-native": "^4.1.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-testing-library": "^6.4.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "jest-watch-typeahead": "^2.2.2",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.3.1",
    "sucrase": "^3.35.0",
    "typescript": "5.3.3"
  },
  "private": true,
  "packageManager": "yarn@4.6.0"
}
